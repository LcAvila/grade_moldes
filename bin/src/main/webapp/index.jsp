<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Cavidades não conformes - Molde 168</title>
<link rel="stylesheet" href="${pageContext.request.contextPath}/css/style.css">
</head>
<body>
<div class="app">
<aside class="painel-form">
<h2>REGISTRAR NÃO CONFORMIDADE</h2>
<div class="resumo-status"><div class="resumo-card"><div class="num" id="resTotal">64</div><div class="lbl">Total</div></div><div class="resumo-card res-ok"><div class="num" id="resOk">64</div><div class="lbl">OK</div></div><div class="resumo-card res-def"><div class="num" id="resDef">0</div><div class="lbl">Defeitos</div></div><div class="resumo-card res-ved"><div class="num" id="resVed">0</div><div class="lbl">Vedadas</div></div></div>
<div class="form-group"><label for="cavidade">Cavidade 1 a 64</label><select id="cavidade"><option value="">Selecione a cavidade</option></select></div>
<div class="form-group"><label for="desvio">Desvio / Defeito</label><select id="desvio"><option value="">Selecione o desvio</option><option value="F.P.F.Q.">F.P.F.Q. - Frente do pino de formato quebrada</option><option value="P.F.Q.">P.F.Q. - Pino do formato quebrado</option><option value="V.P.F.">V.P.F. - Vedada pela ferramentaria</option><option value="REB.">REB. - Rebarba</option><option value="B.V.">B.V. - Bucha virada</option><option value="C.P.Q.">C.P.Q. - Contra pino quebrado</option><option value="B.B.F.Q.">B.B.F.Q. - Boca da bucha do formato quebrada</option><option value="OUTRO">OUTRO - Especificar abaixo</option></select></div>
<div class="form-group" id="obsField" style="display:none"><label for="observacao">Observação / Descrição</label><textarea id="observacao" placeholder="Descreva o defeito ou a região da rebarba..."></textarea></div>
<div class="form-group"><label for="data">Data do Registro</label><input type="date" id="data"></div>
<div class="form-group"><label>Vedado?</label><div class="radio-group"><label><input type="radio" name="vedado" value="S"> Sim</label><label><input type="radio" name="vedado" value="N" checked> Não</label></div></div>
<div class="form-group"><label for="controlador">Controlador Responsável</label><input type="text" id="controlador" value=""></div>
<div class="btn-group"><button class="btn" id="btnSalvar" type="button">SALVAR</button><button class="btn btn-secondary" id="btnLimpar" type="button">LIMPAR</button><button class="btn btn-danger" id="btnExcluir" type="button">EXCLUIR REG.</button></div>
<div class="btn-group"><button class="btn btn-success" id="btnExportar" type="button">EXPORTAR JSON</button><button class="btn btn-secondary" id="btnImportar" type="button">IMPORTAR</button><input type="file" id="fileImport" accept=".json,application/json" hidden><button class="btn btn-secondary" id="btnImprimir" type="button">IMPRIMIR</button></div>
<div class="info-box"><h4>Como usar</h4><p>Clique em uma cavidade no diagrama ou tabela para selecioná-la.</p><p>Preencha os campos e clique em <strong>SALVAR</strong>.</p><p><strong style="color:var(--red)">Vermelho</strong> = Vedado SIM.</p><p><strong style="color:#a66d00">Amarelo</strong> = Defeito / Vedado NÃO.</p><p><strong style="color:var(--muted)">Cinza</strong> = Normal.</p><p><strong>Dica:</strong> clique duas vezes em uma cavidade com registro para ver detalhes.</p></div>
</aside>
<section class="painel-grade">
<div class="header-grade"><div class="logo-box"><svg class="logo-pena" viewBox="0 0 200 40"><rect x="5" y="10" width="100" height="16" rx="4" fill="#f5f5f5" stroke="#1976a8"/><rect x="105" y="8" width="40" height="20" fill="#d0d0d0" stroke="#1976a8"/><polygon points="145,6 170,18 145,30" fill="#125a80" stroke="#1976a8"/><circle cx="175" cy="18" r="5" fill="none" stroke="#1976a8"/></svg><div class="logo-text">COMPACTOR</div><div class="logo-sub">Cia. de Canetas</div></div><div class="title-box"><h1>CAVIDADES NÃO CONFORMES</h1></div><div class="info-molde"><div class="produto"><span class="editable" data-field="produto" contenteditable="true">CONEXÕES ESFEROGRÁFICAS</span></div><div class="molde-num"><strong>Molde </strong><span class="editable" data-field="moldeNum" contenteditable="true">168</span></div><div class="molde-mod"><span class="editable" data-field="moldeMod" contenteditable="true">Coreano SW 1307</span></div></div></div>
<div class="corpo-grade"><div class="tabela-cav"><table><thead><tr><th colspan="5">Esquerda</th><th colspan="5">Direita</th></tr><tr><th>Cav</th><th>Desvio</th><th>Data</th><th>Vedado</th><th>Controlador</th><th>Cav</th><th>Desvio</th><th>Data</th><th>Vedado</th><th>Controlador</th></tr></thead><tbody id="tbodyCavidades"></tbody></table></div><div class="area-direita"><div class="diagrama-box"><svg viewBox="0 0 1300 1350" id="svgDiagrama" xmlns="http://www.w3.org/2000/svg"></svg></div><div class="legenda-box"><h3>LEGENDA</h3><div class="leg-item"><span class="leg-sigla">F.P.F.Q.</span> Frente do pino de formato quebrada</div><div class="leg-item"><span class="leg-sigla">P.F.Q.</span> Pino do formato quebrado</div><div class="leg-item"><span class="leg-sigla">V.P.F.</span> Vedada pela ferramentaria</div><div class="leg-item"><span class="leg-sigla">REB.</span> Rebarba - especificar região</div><div class="leg-item"><span class="leg-sigla">B.V.</span> Bucha virada</div><div class="leg-item"><span class="leg-sigla">C.P.Q.</span> Contra pino quebrado</div><div class="leg-item"><span class="leg-sigla">B.B.F.Q.</span> Boca da bucha do formato quebrada</div></div><div class="info-entrada"><h3>INFORMAÇÕES DE ENTRADA DO MOLDE</h3><div class="info-linha"><span class="info-label">Material</span><span class="editable" data-field="material" contenteditable="true">POLIPROPILENO PP</span></div><div class="info-linha"><span class="info-label">Máquinas</span><span class="editable" data-field="maquina" contenteditable="true">ENGEL 33</span></div><div class="info-linha"><span class="info-label">Controlador resp. abertura</span><span class="editable" data-field="controladorAbertura" contenteditable="true"></span></div><div class="info-linha"><span class="info-label">Data da entrada do molde</span><span class="editable" data-field="dataEntrada" contenteditable="true"></span></div><div class="info-linha"><span class="info-label">Atualização / responsável</span><span class="editable" data-field="dataAtualizacao" contenteditable="true"></span></div><div class="info-linha"><span class="info-label">Observações adicionais</span><span class="editable" data-field="observacoes" contenteditable="true"></span></div></div><div class="revisao">Revisão <span class="editable" data-field="revisaoNum" contenteditable="true">05</span> - Data <span class="editable" data-field="revisaoData" contenteditable="true">20 Março 2020</span></div></div></div>
</section></div>
<div class="modal-overlay" id="modalOverlay"><div class="modal"><h3>Detalhes da Cavidade <span id="modalCavNum"></span></h3><div id="modalConteudo"></div><div class="modal-actions"><button class="btn" id="modalEditar" type="button">EDITAR</button><button class="btn btn-danger" id="modalExcluir" type="button">EXCLUIR</button><button class="btn btn-secondary" id="modalFechar" type="button">FECHAR</button></div></div></div>
<script src="${pageContext.request.contextPath}/js/app.js"></script>
</body>
</html>

{
  "$schema": "https://opencode.ai/config.json",
  "permissions": [
    {
      "action": "read",
      "resource": "C:/Users/lucas_avila/eclipse-workspace/CustomFusionWeb/.opencode/gsd-core/*",
      "effect": "allow"
    },
    {
      "action": "external_directory",
      "resource": "C:/Users/lucas_avila/eclipse-workspace/CustomFusionWeb/.opencode/gsd-core/*",
      "effect": "allow"
    }
  ],
  "mcp": {
    "servers": {
      "gsd": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "-p",
          "@opengsd/gsd-core",
          "gsd-mcp-server",
          "--no-prompts"
        ]
      }
    }
  }
}
